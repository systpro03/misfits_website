# Uploaded files must never be executed as scripts.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
Options -ExecCGI
AddHandler cgi-script .php .phtml .php3 .php4 .php5 .php7 .pht .phar
