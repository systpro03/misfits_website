RewriteEngine On

# ---------------------------------------------------------
# CodeIgniter 3 URL rewriting
# ---------------------------------------------------------

# Allow existing files and directories to load directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send all other requests to CodeIgniter
RewriteRule ^(.+)$ index.php/$1 [L]